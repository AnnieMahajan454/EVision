# EVision example environment variables
# Copy this to .env and edit before running

# App
APP_NAME=EVision API
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1

# Database
# For local dev you can use the sqlite file: sqlite:///C:\Users\annie\EVision\backend\dev.db
# For production, use a Postgres URL: postgresql+psycopg://postgres:password@db:5432/evision
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/evision

# Security
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Development-only flags
# Set to '1' to create tables on startup (only for local/dev)
CREATE_TABLES_ON_START=False

# Models
MODELS_DIR=ml/models

# CORS
CORS_ORIGINS=["http://localhost:5173"]
