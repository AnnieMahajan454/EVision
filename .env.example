# Copy to .env (read by the API from the repo root) or export in your shell.
DATABASE_URL=postgresql+psycopg://evision:evision@localhost:5432/evision

# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Where ml/ saves and the API loads trained models
MODELS_DIR=ml/artifacts

# Tests use their own throwaway database (it is dropped and re-migrated on each run)
TEST_DATABASE_URL=postgresql+psycopg://evision:evision@localhost:5432/evision_test
